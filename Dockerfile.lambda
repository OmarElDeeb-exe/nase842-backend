FROM python:3.11-slim-bookworm

# AWS Lambda Web Adapter
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.1.0 \
    /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AWS_LWA_PORT=8080 \
    AWS_LWA_READINESS_CHECK_PATH=/api/ping

# Install Poetry and Gunicorn
RUN pip install --no-cache-dir \
    poetry==1.8.5 gunicorn==25.3.0

# Install project dependencies
COPY pyproject.toml poetry.lock ./

RUN poetry config virtualenvs.create false \
    && poetry install --only main --no-root \
       --no-interaction --no-ansi

# AWS SDK for Secrets Manager
RUN pip install --no-cache-dir "boto3==1.43.109"

# Copy application
COPY . .

EXPOSE 8080

# Start Flask using Gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:8080", \
     "--workers", "1", "--timeout", "0", \
     "--no-control-socket", "realworld.app:app"]
